# Copiar como .env y completar. NUNCA subir .env al repositorio.
APP_ENV=development
APP_PORT=5000
# En Render el puerto lo asigna la plataforma en PORT (tiene prioridad sobre APP_PORT).

# Supabase -> botón "Connect" -> Direct -> Session pooler -> URI (funciona en redes IPv4).
# Reemplazar [YOUR-PASSWORD] por la contraseña de la BD (sin corchetes).
DATABASE_URL=postgresql://postgres:<password>@<host>:5432/postgres

# Clave para firmar los JWT: mínimo 32 caracteres fuera de desarrollo (python -c "import secrets;print(secrets.token_urlsafe(48))")
JWT_SECRET_KEY=cambiar-por-una-clave-segura
JWT_EXPIRES_MINUTES=60

# Origenes permitidos para CORS (frontend). Separar con comas. '*' solo vale en desarrollo.
CORS_ORIGINS=http://localhost:5000,http://localhost:8080

# Correo para enviar el código de verificación (Gmail: https://myaccount.google.com/apppasswords, requiere
# verificación en dos pasos). Sin esto, en desarrollo el código se escribe en el log del servidor.
# Fuera de desarrollo son obligatorias.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Kuntur EC <tu-correo@gmail.com>

# Inicio de sesión con Google: ID de cliente OAuth de tipo "Aplicación web" (Google Cloud > Google Auth Platform >
# Clientes). No es secreto. Vacío = el botón de Google responde que no está disponible.
GOOGLE_CLIENT_ID=

# El IVA NO se configura aquí: se gestiona en la tabla tarifas_iva (historial con vigencias).
