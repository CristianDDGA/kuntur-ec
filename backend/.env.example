# Copiar como .env y completar. NUNCA subir .env al repositorio.
APP_ENV=development
APP_PORT=5000

# Supabase -> botón "Connect" -> Direct -> Session pooler -> URI (funciona en redes IPv4).
# Reemplazar [YOUR-PASSWORD] por la contraseña de la BD (sin corchetes).
DATABASE_URL=postgresql://postgres:<password>@<host>:5432/postgres

# Clave para firmar los JWT (usar un valor largo y aleatorio)
JWT_SECRET_KEY=cambiar-por-una-clave-segura
JWT_EXPIRES_MINUTES=60

# Origenes permitidos para CORS (frontend). Separar con comas.
CORS_ORIGINS=*

# El IVA NO se configura aquí: se gestiona en la tabla tarifas_iva (historial con vigencias).
